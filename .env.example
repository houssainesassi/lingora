# Copy to .env.local and fill in your own values. Never commit real secrets.

# --- Supabase (required) ----------------------------------------------------
# Project Settings -> API (or "API Keys") in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# New projects: the "publishable" key (sb_publishable_...).
# Older projects can instead set NEXT_PUBLIC_SUPABASE_ANON_KEY (legacy anon key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# The service-role key is NOT needed by this app. Do not add it.

# --- Site URL (recommended in production) -----------------------------------
# Used for auth email redirect links. On Vercel, VERCEL_URL is used as a fallback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- LiveKit (optional, required for voice/video lessons) -------------------
# LiveKit Cloud -> Project -> Settings -> Keys. Server-side only.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Optional ---------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL=
